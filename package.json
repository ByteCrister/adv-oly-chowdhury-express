{
  "name": "adv-oly-chowdhury-express",
  "version": "1.0.0",
  "description": "Production-Ready Standalone Express.js Cron Cleanup Server for Advocate Oly Chowdhury Chamber Management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "cron",
    "cleanup",
    "mongoose",
    "mongodb",
    "cloudinary",
    "typescript"
  ],
  "author": "ByteCrister",
  "license": "ISC",
  "dependencies": {
    "@upstash/redis": "^1.34.4",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.8",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
