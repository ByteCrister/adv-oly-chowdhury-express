# ==============================================================================
# Advocate Oly Chowdhury Chamber Management - Express Cron Cleanup Server
# Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to '.env' and fill in the values.
# NEVER commit the actual '.env' file or production credentials to version control.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# MongoDB Database Connection
# Must be a valid MongoDB connection string (standalone or replica set / Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/oly_chowdhury_db?retryWrites=true&w=majority

# Cron Authentication Secret
# Must be at least 16 characters for security. Used by external schedulers (Vercel Cron, QStash, etc.)
# via 'Authorization: Bearer <secret>' or 'x-cron-secret: <secret>'
CRON_SECRET=replace_with_a_secure_random_string_min_16_characters

# Cloudinary Storage Configuration
# Used to destroy orphaned physical assets during media cleanup
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER_NAME=adv-oly-chowdhury

# Distributed Execution Lock (Optional - Upstash Redis)
# If provided, distributed NX/EX lease locks are used across instances.
# If omitted, safe in-process locking with auto-release is used automatically.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
